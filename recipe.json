{
	"name": "asyncdb",
	"compiler": "g++ -O2 -g -Wall -Werror -std=c++20",
	"packaging": "executable",
	"modules": [],
	"test":
		{
			"args": "--gtest_color=true"
		},
	"dependencies":
		[
			{
				"package": "rocksdb"
			},
			{
				"package": "libcurl"
			},
			{
				"package": "gtest",
				"scope": "test"
			},
			{
				"package": "gmock",
				"scope": "test"
			}
		],
	"plugins":
		[
			{
				"name": "version",
				"phase": "validate",
				"config":
					{
					}
			},
			{
				"name": "cppcheck",
				"phase": "validate",
				"config":
					{
						"options": "--enable=style"
					}
			},
			{
				"name": "valgrind",
				"phase": "verify",
				"config":
					{
						"options": "--suppressions=valgrind.supp"
					}
			}
		],
	"define":
		{
			"LOG": "echo 1"
		}
}
